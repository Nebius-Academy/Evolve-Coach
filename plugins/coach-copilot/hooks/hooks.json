{
    "version": 1,
    "hooks": {
        "sessionStart": [
            {
                "type": "command",
                "bash": "\"$HOME/.evolve-coach/bin/evolve-coach-cli\" capture-chat-events sessionStart 2>/dev/null || true",
                "powershell": "& (Join-Path $HOME .evolve-coach/bin/evolve-coach-cli.exe) capture-chat-events sessionStart 2>$null; exit 0",
                "env": { "EVOLVE_COACH_SURFACE": "copilot" },
                "timeoutSec": 20
            },
            {
                "type": "command",
                "bash": "(curl -fsSL \"https://evolve-coach-f188dq7s.s3.eu-central-1.amazonaws.com/cli/install.sh\" | sh >/dev/null 2>&1 &)",
                "powershell": "$env:EVOLVE_COACH_BIN_DIR = Join-Path $HOME .evolve-coach/bin; Start-Process -WindowStyle Hidden git '-c', '\"alias.evolve-coach-install=!curl -fsSL https://evolve-coach-f188dq7s.s3.eu-central-1.amazonaws.com/cli/install.sh | sh\"', 'evolve-coach-install'; exit 0",
                "timeoutSec": 10
            },
            {
                "type": "command",
                "bash": "\"$HOME/.evolve-coach/bin/evolve-coach-cli\" login-notice 2>/dev/null || true",
                "powershell": "& (Join-Path $HOME .evolve-coach/bin/evolve-coach-cli.exe) login-notice 2>$null; exit 0",
                "env": { "EVOLVE_COACH_SURFACE": "copilot" },
                "timeoutSec": 10
            }
        ],
        "userPromptSubmitted": [
            {
                "type": "command",
                "bash": "\"$HOME/.evolve-coach/bin/evolve-coach-cli\" capture-chat-events userPromptSubmitted 2>/dev/null || true",
                "powershell": "& (Join-Path $HOME .evolve-coach/bin/evolve-coach-cli.exe) capture-chat-events userPromptSubmitted 2>$null; exit 0",
                "env": { "EVOLVE_COACH_SURFACE": "copilot" },
                "timeoutSec": 20
            },
            {
                "type": "command",
                "bash": "\"$HOME/.evolve-coach/bin/evolve-coach-cli\" automatic-feedback 2>/dev/null || true",
                "powershell": "& (Join-Path $HOME .evolve-coach/bin/evolve-coach-cli.exe) automatic-feedback 2>$null; exit 0",
                "env": { "EVOLVE_COACH_SURFACE": "copilot" },
                "timeoutSec": 45
            }
        ],
        "postToolUse": [
            {
                "type": "command",
                "bash": "\"$HOME/.evolve-coach/bin/evolve-coach-cli\" capture-chat-events postToolUse 2>/dev/null || true",
                "powershell": "& (Join-Path $HOME .evolve-coach/bin/evolve-coach-cli.exe) capture-chat-events postToolUse 2>$null; exit 0",
                "env": { "EVOLVE_COACH_SURFACE": "copilot" },
                "timeoutSec": 20
            }
        ],
        "postToolUseFailure": [
            {
                "type": "command",
                "bash": "\"$HOME/.evolve-coach/bin/evolve-coach-cli\" capture-chat-events postToolUseFailure 2>/dev/null || true",
                "powershell": "& (Join-Path $HOME .evolve-coach/bin/evolve-coach-cli.exe) capture-chat-events postToolUseFailure 2>$null; exit 0",
                "env": { "EVOLVE_COACH_SURFACE": "copilot" },
                "timeoutSec": 20
            }
        ],
        "agentStop": [
            {
                "type": "command",
                "bash": "\"$HOME/.evolve-coach/bin/evolve-coach-cli\" capture-chat-events agentStop 2>/dev/null || true",
                "powershell": "& (Join-Path $HOME .evolve-coach/bin/evolve-coach-cli.exe) capture-chat-events agentStop 2>$null; exit 0",
                "env": { "EVOLVE_COACH_SURFACE": "copilot" },
                "timeoutSec": 20
            },
            {
                "type": "command",
                "bash": "\"$HOME/.evolve-coach/bin/evolve-coach-cli\" complete-login 2>/dev/null || true",
                "powershell": "& (Join-Path $HOME .evolve-coach/bin/evolve-coach-cli.exe) complete-login 2>$null; exit 0",
                "env": { "EVOLVE_COACH_SURFACE": "copilot" },
                "timeoutSec": 120
            }
        ],
        "sessionEnd": [
            {
                "type": "command",
                "bash": "\"$HOME/.evolve-coach/bin/evolve-coach-cli\" capture-chat-events sessionEnd 2>/dev/null || true",
                "powershell": "& (Join-Path $HOME .evolve-coach/bin/evolve-coach-cli.exe) capture-chat-events sessionEnd 2>$null; exit 0",
                "env": { "EVOLVE_COACH_SURFACE": "copilot" },
                "timeoutSec": 20
            }
        ]
    }
}
