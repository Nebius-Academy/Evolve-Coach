{
    "version": 1,
    "hooks": {
        "sessionStart": [
            {
                "type": "command",
                "bash": "\"${EVOLVE_COACH_BIN:-${COPILOT_HOME:-$HOME/.copilot}/evolve-coach/bin/evolve-coach-cli}\" capture-chat-events sessionStart 2>/dev/null || true",
                "powershell": "[Console]::In.ReadToEnd() | & ($env:EVOLVE_COACH_BIN ?? (Join-Path ($env:COPILOT_HOME ?? (Join-Path $HOME .copilot)) evolve-coach/bin/evolve-coach-cli.exe)) capture-chat-events sessionStart 2>$null; exit 0",
                "env": { "EVOLVE_COACH_SURFACE": "copilot" },
                "timeoutSec": 20
            },
            {
                "type": "command",
                "bash": "(curl -fsSL \"https://evolve-coach-f188dq7s.s3.eu-central-1.amazonaws.com/cli/install.sh\" | EVOLVE_COACH_BIN_DIR=\"${COPILOT_HOME:-$HOME/.copilot}/evolve-coach/bin\" sh >/dev/null 2>&1 &)",
                "powershell": "$env:EVOLVE_COACH_BIN_DIR = Join-Path ($env:COPILOT_HOME ?? (Join-Path $HOME .copilot)) evolve-coach/bin; Start-Process -WindowStyle Hidden git '-c', '\"alias.evolve-coach-install=!curl -fsSL https://evolve-coach-f188dq7s.s3.eu-central-1.amazonaws.com/cli/install.sh | sh\"', 'evolve-coach-install'; exit 0",
                "timeoutSec": 10
            },
            {
                "type": "command",
